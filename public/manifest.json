{
  "manifest_version": 3,
  "name": "Hyperclick",
  "version": "0.7.3",
  "description": "通过 OKX 或 OneKey 协调 HyperCore 原生多签操作",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.hyperliquid.xyz/*",
    "https://api.hyperliquid-testnet.xyz/*",
    "https://app.hyperliquid.xyz/*",
    "https://app.hyperliquid-testnet.xyz/*"
  ],
  "action": {
    "default_title": "Hyperclick",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.hyperliquid.xyz/*",
        "https://app.hyperliquid-testnet.xyz/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.hyperliquid.xyz/*",
        "https://app.hyperliquid-testnet.xyz/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://api.hyperliquid.xyz https://api.hyperliquid-testnet.xyz; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
  },
  "side_panel": {
    "default_path": "panel.html?side=1"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
